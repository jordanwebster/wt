#!/bin/sh
set -eu

: "${WT_STUB_LOG:?WT_STUB_LOG is required}"
printf 'tmux' >> "$WT_STUB_LOG"
for argument in "$@"; do
    printf '\t%s' "$argument" >> "$WT_STUB_LOG"
done
printf '\n' >> "$WT_STUB_LOG"

state=${WT_STUB_STATE:-/dev/null}
if [ "${1:-}" = "-V" ]; then
    version=$(sed -n 's/^version=//p' "$state" 2>/dev/null | head -n 1)
    printf 'tmux %s\n' "${version:-3.2}"
    exit 0
fi
if [ "${1:-}" = "has-session" ]; then
    session=${3:-}
    grep -Fqx "session=$session" "$state" 2>/dev/null
    exit $?
fi
if [ "${1:-}" = "new-session" ]; then
    session=
    previous=
    for argument in "$@"; do
        if [ "$previous" = "-s" ]; then session=$argument; break; fi
        previous=$argument
    done
    if grep -Fqx "session=$session" "$state" 2>/dev/null; then exit 1; fi
    if [ "$state" != /dev/null ]; then printf 'session=%s\n' "$session" >> "$state"; fi
fi
exit_code=$(sed -n 's/^exit=//p' "$state" 2>/dev/null | head -n 1)
exit "${exit_code:-0}"
